{
  "task_name": "Подсчет винтиков",
  "model_path": "models/screws.pt",
  "task_type": "counting",

  "counting_zone": {
    "x_start": 0.73,
    "x_end": 0.80,
    "enabled": true
  },

  "visualization": {
    "show_labels": true,
    "label_format": "#{id}",
    "box_color_default": [255, 0, 0],
    "box_color_in_zone": [0, 255, 0],
    "zone_color": [0, 255, 255]
  },

  "detection": {
    "confidence": 0.3,
    "iou": 0.3,
    "target_class": 0
  },

  "processing": {
    "use_barcode_reading": false,
    "use_tracking": true,
    "tracker_max_age": 20,
    "tracker_max_distance": 80
  }
}
